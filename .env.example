# Copy this file to .env and fill in the values. Never commit .env.

# --- Paths ---
DATA_DIR=data

# --- Chunking (starting points, see SPEC.md §6) ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- Embeddings ---
# Must handle French. Changing it requires rebuilding the index.
EMBEDDING_MODEL=intfloat/multilingual-e5-base

# --- Retrieval ---
TOP_K=5

# --- LLM ---
# "ollama" (local Ollama server) or "api" (any OpenAI-compatible chat API).
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=mistral
# Defaults to LM Studio's local server (no key needed). Hosted alternatives:
# https://openrouter.ai/api/v1 or https://router.huggingface.co/v1 (keys required).
LLM_API_BASE_URL=http://localhost:1234/v1
LLM_API_MODEL=
LLM_API_KEY=
