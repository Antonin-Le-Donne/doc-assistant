# Copy this file to .env and fill in the values. Never commit .env.

# --- Paths ---
DATA_DIR=data

# --- Chunking (starting points, see SPEC.md §6) ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- Embeddings ---
# Must handle French. Changing it requires rebuilding the index.
EMBEDDING_MODEL=

# --- Retrieval ---
TOP_K=5

# --- LLM ---
# "ollama" (local, no key needed) or "api" (hosted, needs a key)
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=
LLM_API_MODEL=
LLM_API_KEY=
